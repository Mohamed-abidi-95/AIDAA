# ============================================================================
# AIDAA Backend — Variables d'environnement
# ============================================================================
# INSTRUCTIONS :
#   Windows : copy .env.example .env
#   Mac/Linux : cp .env.example .env
#   Puis remplir les valeurs ci-dessous dans .env
# ============================================================================

# Serveur
PORT=5000

# Base de données MySQL (XAMPP par défaut — root sans mot de passe)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=aidaa_db

# JWT — IMPORTANT : changer en production !
JWT_SECRET=aidaa_super_secret_pfe_2026_change_me
JWT_EXPIRES_IN=7d

# CORS — autoriser toutes les origines en dev
CORS_ORIGIN=*

# URL du frontend Vite
FRONTEND_URL=http://localhost:5173

# ============================================================================
# Email SMTP — OPTIONNEL
# Laisser SMTP_PASS vide → mode Ethereal (emails fictifs, aperçu dans console)
# Avec Resend (gratuit 100/jour) : SMTP_USER=resend, SMTP_PASS=re_xxxxxxxxx
# ============================================================================
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM=AIDAA <noreply@aidaa.com>

# ============================================================================
# Gemini AI — OPTIONNEL
# Clé gratuite : https://aistudio.google.com/app/apikey
# Laisser vide → chatbot en mode FAQ keyword-matching uniquement
# ============================================================================
GEMINI_API_KEY=
